{
  "name": "vue-component-graph",
  "version": "0.1.0",
  "description": "Visualize Vue component dependencies and the pages each component appears on, find the impact of changes, and expose it all to AI agents over MCP",
  "author": "Kota Mizuno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotta-27/vue-component-graph.git"
  },
  "homepage": "https://github.com/kotta-27/vue-component-graph#readme",
  "bugs": {
    "url": "https://github.com/kotta-27/vue-component-graph/issues"
  },
  "type": "module",
  "bin": {
    "vue-component-graph": "./dist/cli.js"
  },
  "files": [
    "dist",
    "viewer"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "node dist/cli.js examples/shop"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vue",
    "cli",
    "dependency-graph",
    "visualization"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vue/compiler-sfc": "^3.5.44",
    "cac": "^7.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/types": "^7.29.11",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
